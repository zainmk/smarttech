{"sections":{"main":{"type":"main-page","settings":{}},"5b5ee638-a5a2-4db1-b2a9-10056d4327f9":{"type":"image-with-text","settings":{"image":"shopify:\/\/shop_images\/StoreFront_1.jpg","image_position":"left","image_width":45,"title":"","content":"<h3><strong>Who are we?<\/strong><\/h3><p><strong>SmartTech Deals<\/strong><\/p><p><em>A local Calgary business which boomed due to great deals on <\/em><em><strong>open-box <\/strong><\/em><em>products, good customer service and an 30-day warranty with <\/em>guarantee<em> that you are satisfied <\/em>with<em> your purchase. Our customers have turned SmartTech from a basic company idea to a vital part of Calgary’s tech sector. But our business is not just a low-cost shop; rather, it's a location where customers could be helped with to get the best product per dollar based on their specific needs. Within 4 years of operations, SmartTech has had over thousands of delighted costumers, and is on the rise! The world of ecommerce tech is changing, and SmartTech gladly accepts that today's clients are more tech aware and want more bang for their buck. We think that one main constant for satisfied customers is better prices and we will constantly work to provide you with the best electronics and tech deals possible online!<\/em><\/p><p><\/p><p><\/p><p><\/p><p><\/p><h3><strong>Why Trust Us?<\/strong><\/h3><ul><li><strong>Payment Security: <\/strong>Website is hosted on Shopify Platform which has PCI Level 1 Compliance and Security. Ensures your payment information is SAFE and all sales will be resolved.<\/li><li><strong>Business Legitimacy: <\/strong>We have been a fully fledged  legal business operating in Calgary, Alberta for the past 4 years.<\/li><li><strong>Customer Relations: <\/strong>Check out the reviews and see for yourself that we make sure every customer is satisfied with their purchase.<\/li><li><strong>Product Conditions: <\/strong>Each product is very carefully inspected and examined to ensure it meets the criteria for the written <a href=\"\/pages\/product-conditions\" target=\"_blank\" title=\"Product Conditions\">product condition<\/a>. <\/li><li><strong>Always There!: <\/strong>Still Unsure? Chat with us using the ChatBox or <a href=\"\/pages\/contact-us\" target=\"_blank\" title=\"Contact Us\">Contact Us<\/a><\/li><\/ul><h5><\/h5>","button_text":"","button_link":"shopify:\/\/collections\/most-popular"}},"custom_html_Ek6zHa":{"type":"custom-html","custom_css":[],"settings":{"title":"","html":"<a href=\"https:\/\/www.shopify.com\/security\/pci-compliant?utm_medium=shop&amp;utm_source=secure\" title=\"This online store is secured by Shopify\" target=\"_blank\" rel=\"nofollow\">\n\n\n<img style=\"display: block; margin-left: auto; margin-right: auto; width: 15%\" src=\"https:\/\/cdn.shopify.com\/s\/images\/badges\/shopify-secure-badge-white.svg\" alt=\"Shopify secure badge\">\n<\/a>"}},"e399b597-dcb6-42c3-ace0-cc9e9b2193cf":{"type":"rich-text","settings":{"text_width":"narrow","title":"Reviews","content":"","button_text":"Leave a review!","button_link":"https:\/\/g.page\/r\/CVdSojxBlk_0EBM\/review"}},"custom_liquid_twJ7r9":{"type":"custom-liquid","settings":{"title":"","include_margins":true,"liquid":"<script src=\"https:\/\/static.elfsight.com\/platform\/platform.js\" data-use-service-core defer><\/script>\n<div class=\"elfsight-app-78f46d18-d071-40a8-a48a-50567d9d4075\" data-elfsight-app-lazy><\/div>"}},"bb2177cb-7ca8-42c3-ad06-1f2f9483fa49":{"type":"custom-html","disabled":true,"settings":{"title":"","html":"<div class=\"sk-ww-google-reviews\" data-embed-id=\"245760\"><\/div><script src=\"https:\/\/widgets.sociablekit.com\/google-reviews\/widget.js\" async=\"\" defer><\/script>"}},"16457572918faa9883":{"type":"collection-list","blocks":{"dadc3877-553a-4861-b775-9402b93dffa2":{"type":"collection","settings":{"collection":"software","link":""}},"1645757291f81f690b-3":{"type":"collection","settings":{"collection":"ram","link":""}},"1645757291f81f690b-1":{"type":"collection","se